{% extends 'base.html.twig' %}

{% block title %}Nouveau bateau pour {{ account.firstname }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Ajouter un bateau</h1>
        <p class="text-muted">Propriétaire : <strong>{{ account.firstname }} {{ account.lastname }}</strong></p>

        <hr>

        {{ form_start(form) }}
        <div class="my-custom-class">
            {{ form_errors(form) }}

            <div class="mb-3">
                {{ form_row(form.name, {'label': 'Nom du bateau'}) }}
            </div>

            <div class="mb-3">
                {{ form_row(form.purchasePrice, {'label': 'Prix d\'achat (€)'}) }}
            </div>
        </div>

        <button type="submit" class="btn btn-success">
            Enregistrer le contrat
        </button>

        <a href="{{ path('app_account_boats', {'firstname': account.firstname}) }}" class="btn btn-secondary">
            Annuler
        </a>


        {{ form_end(form) }}
    </div>
{% endblock %}
