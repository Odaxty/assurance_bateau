{% extends 'base.html.twig' %}

{% block title %}Projet Assurance{% endblock %}

{% block body %}
    <div>
        <div>
            <h1>⚓ Gestionnaire d'Assurances</h1>
            <p>Bienvenue sur votre interface de gestion d'assurance</p>
        </div>

        <div>
            <div>
                <h5>Clients</h5>
                <a href="{{ path('app_register') }}">Créer un Compte</a>
            </div>

            <hr>

            <div>
                <h5>Enregistrer un Bateau </h5>
                <p>Entrez votre nom :</p>
                <form action="{{ path('app_boat_new') }}">
                    <label>
                        <input type="text" name="firstname" class="form-control" placeholder="Ex: Théo" required>
                    </label>
                    <button type="submit" class="btn btn-primary">Créer le bateau</button>
                </form>
            </div>

            <hr>

            <div>
                <h5>Télécharger mon Contrat PDF</h5>
                <p>Entrez le numéro ID de votre bateau (possible de le voir dans la liste des bateaux) :</p>

                <form action="{{ path('app_insurance_download') }}" method="GET">
                    <div class="input-group mb-3">
                        <input type="number" name="id" class="form-control" placeholder="Ex: 1" required>
                        <button type="submit" class="btn btn-success">Générer le PDF</button>
                    </div>
                </form>
            </div>

            <hr>

            <div>
                <h5>Statistiques</h5>
                <p>Voir la flotte globale et les bateaux de luxe.</p>
                <ul>
                    <li><a href="{{ path('app_boat_list') }}">Tous les bateaux</a></li>
                    <li><a href="{{ path('app_boat_luxury') }}">Flotte de Luxe</a></li>
                    <li><a href="{{ path('app_account_list') }}">Tous les comptes</a></li>
                </ul>
            </div>
        </div>
    </div>
{% endblock %}
